{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wisdom/S2_output/0.2.0",
  "title": "S2 theme and topic tagger",
  "description": "Placeholders like $THEME_IDS are replaced with codebook values when the prompt is assembled. Numeric limits are enforced by the verifier (V1), not the API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "records"
  ],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "themes",
          "topics",
          "proposal",
          "confidence"
        ],
        "properties": {
          "unit_id": {
            "type": "string"
          },
          "themes": {
            "type": "array",
            "description": "At most 3",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "salience",
                "span"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "enum": "$THEME_IDS"
                },
                "salience": {
                  "type": "integer",
                  "description": "0 to 3"
                },
                "span": {
                  "type": "string"
                }
              }
            }
          },
          "topics": {
            "type": "array",
            "description": "At most 3",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "salience",
                "span"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "enum": "$TOPIC_IDS"
                },
                "salience": {
                  "type": "integer",
                  "description": "0 to 3"
                },
                "span": {
                  "type": "string"
                }
              }
            }
          },
          "proposal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "reason",
              "span"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "span": {
                "type": "string"
              }
            }
          },
          "confidence": {
            "type": "number",
            "description": "0 to 1"
          }
        }
      }
    }
  }
}
